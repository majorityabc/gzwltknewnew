generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Textbook {
  id        Int       @id @default(autoincrement())
  name      String
  grade     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  chapters  Chapter[]
  papers    Paper[]
  studentQuestions StudentQuestion[]

  @@map("textbooks")
}

model Chapter {
  id              Int              @id @default(autoincrement())
  textbookId      Int              @map("textbook_id")
  parentId        Int?             @map("parent_id")
  title           String
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  textbook        Textbook         @relation(fields: [textbookId], references: [id])
  parent          Chapter?         @relation("ChapterTree", fields: [parentId], references: [id])
  children        Chapter[]        @relation("ChapterTree")
  knowledgePoints KnowledgePoint[]
  lessons         Lesson[]
  studentQuestions StudentQuestion[]

  @@map("chapters")
}

model Lesson {
  id         Int      @id @default(autoincrement())
  chapterId  Int      @map("chapter_id")
  title      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  chapter    Chapter  @relation(fields: [chapterId], references: [id])
  studentQuestions StudentQuestion[]

  @@map("lessons")
}

model KnowledgePoint {
  id        Int                      @id @default(autoincrement())
  chapterId Int                      @map("chapter_id")
  name      String
  sortOrder Int                      @default(0) @map("sort_order")
  createdAt DateTime                 @default(now()) @map("created_at")
  chapter   Chapter                  @relation(fields: [chapterId], references: [id])
  problems  ProblemKnowledgePoint[]

  @@map("knowledge_points")
}

model Problem {
  id             Int                      @id @default(autoincrement())
  content        String                   // TipTap JSON
  contentHash    String                   @default("") // 归一化内容哈希（查重用）
  difficulty     Int                      @default(1)
  lessonTitle    String?                  @map("lesson_title")  // 课时标题，如"共点力的平衡"
  questionType   String?                  @map("question_type") // 题型：单选/多选/实验/计算
  sourceDate     String?                  @map("source_date")   // 题目来源日期，如"2024-06-07"
  remarks        String?                                               // 备注
  answer         String?                                               // 答案（TipTap JSON）
  createdAt      DateTime                 @default(now()) @map("created_at")
  knowledgePoints ProblemKnowledgePoint[]

  @@index([contentHash])
  @@map("problems")
}

model ProblemImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      String   // base64
  createdAt DateTime @default(now())
  studentQuestionImages StudentQuestionImage[]

  @@map("problem_images")
}

model ProblemKnowledgePoint {
  problemId        Int            @map("problem_id")
  knowledgePointId Int            @map("knowledge_point_id")
  problem          Problem        @relation(fields: [problemId], references: [id])
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id])

  @@id([problemId, knowledgePointId])
  @@map("problem_knowledge_points")
}

// 试卷库：整卷存档（Word / PDF 原文件）
model Paper {
  id         Int       @id @default(autoincrement())
  title      String
  paperType  String    @default("其他") // 单元测试 / 月考 / 期中 / 期末 / 其他
  remarks    String?
  fileName   String
  fileSize   Int
  fileType   String    @default("docx") // docx | pdf
  downloadCount Int     @default(0) // 下载次数
  fileData   String // base64 文件本体
  textbookId Int?
  textbook   Textbook? @relation(fields: [textbookId], references: [id])
  folderId   Int?
  folder     PaperFolder? @relation(fields: [folderId], references: [id])
  shareToken String?   @unique // 公开分享暗号，凭此可免登录下载
  lecturesPaperId Int?     // 已发送到讲义站的试卷 id
  lecturesSentAt  DateTime? // 发送时间
  createdAt  DateTime  @default(now())
}

model Lecture {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("") // TipTap JSON
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lectures")
}

model PaperFolder {
  id        Int           @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    PaperFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  PaperFolder[] @relation("FolderTree")
  createdAt DateTime      @default(now())
  papers    Paper[]
}

// ============ 学生问题库 ============
// 课上学生提问的原始记录：一句话/一张截图即可，按 课本→章→课时 归类
model StudentQuestion {
  id          Int       @id @default(autoincrement())
  content     String    @default("")                 // 学生原话（纯文本）
  studentName String?   @map("student_name")          // 谁问的（可空）
  textbookId  Int?      @map("textbook_id")
  textbook    Textbook? @relation(fields: [textbookId], references: [id])
  chapterId   Int?      @map("chapter_id")
  chapter     Chapter?  @relation(fields: [chapterId], references: [id])
  lessonId    Int?      @map("lesson_id")
  lesson      Lesson?   @relation(fields: [lessonId], references: [id])
  status      String    @default("待讲解")            // 待讲解 / 已解答
  askedAt     DateTime  @default(now()) @map("asked_at") // 提问时间（可回溯补录）
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  images      StudentQuestionImage[]

  @@map("student_questions")
}

model StudentQuestionImage {
  id         String          @id @default(cuid())
  questionId Int             @map("question_id")
  question   StudentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  imageId    String          @map("image_id")
  image      ProblemImage    @relation(fields: [imageId], references: [id])
  sortOrder  Int             @default(0) @map("sort_order")

  @@map("student_question_images")
}

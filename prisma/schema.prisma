generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Textbook {
  id        Int       @id @default(autoincrement())
  name      String
  grade     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  chapters  Chapter[]
  papers    Paper[]

  @@map("textbooks")
}

model Chapter {
  id              Int              @id @default(autoincrement())
  textbookId      Int              @map("textbook_id")
  parentId        Int?             @map("parent_id")
  title           String
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  textbook        Textbook         @relation(fields: [textbookId], references: [id])
  parent          Chapter?         @relation("ChapterTree", fields: [parentId], references: [id])
  children        Chapter[]        @relation("ChapterTree")
  knowledgePoints KnowledgePoint[]
  lessons         Lesson[]

  @@map("chapters")
}

model Lesson {
  id         Int      @id @default(autoincrement())
  chapterId  Int      @map("chapter_id")
  title      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  chapter    Chapter  @relation(fields: [chapterId], references: [id])

  @@map("lessons")
}

model KnowledgePoint {
  id        Int                      @id @default(autoincrement())
  chapterId Int                      @map("chapter_id")
  name      String
  sortOrder Int                      @default(0) @map("sort_order")
  createdAt DateTime                 @default(now()) @map("created_at")
  chapter   Chapter                  @relation(fields: [chapterId], references: [id])
  problems  ProblemKnowledgePoint[]

  @@map("knowledge_points")
}

model Problem {
  id             Int                      @id @default(autoincrement())
  content        String                   // TipTap JSON
  contentHash    String                   @default("") // 归一化内容哈希（查重用）
  difficulty     Int                      @default(1)
  lessonTitle    String?                  @map("lesson_title")  // 课时标题，如"共点力的平衡"
  questionType   String?                  @map("question_type") // 题型：单选/多选/实验/计算
  sourceDate     String?                  @map("source_date")   // 题目来源日期，如"2024-06-07"
  remarks        String?                                               // 备注
  answer         String?                                               // 答案（TipTap JSON）
  createdAt      DateTime                 @default(now()) @map("created_at")
  knowledgePoints ProblemKnowledgePoint[]

  @@index([contentHash])
  @@map("problems")
}

model ProblemImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      String   // base64
  createdAt DateTime @default(now())

  @@map("problem_images")
}

model ProblemKnowledgePoint {
  problemId        Int            @map("problem_id")
  knowledgePointId Int            @map("knowledge_point_id")
  problem          Problem        @relation(fields: [problemId], references: [id])
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id])

  @@id([problemId, knowledgePointId])
  @@map("problem_knowledge_points")
}

// 试卷库：整卷存档（Word / PDF 原文件）
model Paper {
  id         Int       @id @default(autoincrement())
  title      String
  paperType  String    @default("其他") // 单元测试 / 月考 / 期中 / 期末 / 其他
  remarks    String?
  fileName   String
  fileSize   Int
  fileType   String    @default("docx") // docx | pdf
  downloadCount Int     @default(0) // 下载次数
  fileData   String // base64 文件本体
  textbookId Int?
  textbook   Textbook? @relation(fields: [textbookId], references: [id])
  shareToken String?   @unique // 公开分享暗号，凭此可免登录下载
  createdAt  DateTime  @default(now())
}
